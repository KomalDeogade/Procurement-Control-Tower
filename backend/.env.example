# SCM Procurement Control Tower — Environment Configuration
# Copy this to .env and fill in values as needed.

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./scm_procurement.db

# ── Authentication ─────────────────────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# ── AI Configuration ───────────────────────────────────────────
# Set AI_PROVIDER to "openai", "gemini", or "anthropic"
# Leave as "none" to use deterministic mock responses (works offline)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# OpenAI example:
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# Google Gemini example:
# AI_PROVIDER=gemini
# AI_API_KEY=AIza...
# AI_MODEL=gemini-1.5-flash

# Anthropic example:
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-...
# AI_MODEL=claude-3-haiku-20240307

# ── n8n Integration (optional) ────────────────────────────────
# N8N_WEBHOOK_BASE=http://localhost:5678
# N8N_API_KEY=

# ── Mock SAP ──────────────────────────────────────────────────
MOCK_SAP_URL=http://localhost:8001

# ── Application ────────────────────────────────────────────────
APP_NAME=SCM Procurement Control Tower
APP_ENV=development
