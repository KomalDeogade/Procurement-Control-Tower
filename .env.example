# ===========================================
# SCM Procurement Control Tower - Environment
# ===========================================
# Copy this file to .env and fill in your values.
# Do NOT commit .env to source control.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://scm_user:scm_password@postgres:5432/scm_procurement
POSTGRES_USER=scm_user
POSTGRES_PASSWORD=scm_password
POSTGRES_DB=scm_procurement

# --- Authentication ---
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# --- AI Configuration (Future) ---
AI_PROVIDER=none
AI_API_KEY=your-ai-api-key-here
AI_MODEL=gpt-4

# --- Mock SAP ---
MOCK_SAP_URL=http://mock-sap:8001
MOCK_SAP_API_KEY=mock-sap-api-key

# --- n8n (Optional) ---
N8N_BASE_URL=http://n8n:5678
N8N_WEBHOOK_URL=http://n8n:5678/webhook

# --- Application ---
APP_NAME=SCM Procurement Control Tower
APP_ENV=development
APP_DEBUG=true
BACKEND_PORT=8000
FRONTEND_PORT=5173
